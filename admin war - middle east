  <script>
    /* Tab Switcher Logic */
    function switchTab(type) {
      const tabAdmin = document.getElementById('tab-admin');
      const tabSupporters = document.getElementById('tab-supporters');
      const contentAdmin = document.getElementById('content-admin');
      const contentSupporters = document.getElementById('content-supporters');

      if (type === 'admin') {
        tabAdmin.className = "tab-btn tab-active flex-1 py-3 px-2 text-center text-xs sm:text-sm font-black flex items-center justify-center gap-1.5";
        tabSupporters.className = "tab-btn tab-inactive flex-1 py-3 px-2 text-center text-xs sm:text-sm font-black flex items-center justify-center gap-1.5";
        contentAdmin.classList.remove('hidden');
        contentSupporters.classList.add('hidden');
      } else {
        tabSupporters.className = "tab-btn tab-active flex-1 py-3 px-2 text-center text-xs sm:text-sm font-black flex items-center justify-center gap-1.5";
        tabAdmin.className = "tab-btn tab-inactive flex-1 py-3 px-2 text-center text-xs sm:text-sm font-black flex items-center justify-center gap-1.5";
        contentSupporters.classList.remove('hidden');
        contentAdmin.classList.add('hidden');
      }
    }

    /* Ambient Gold Dust Canvas Animation */
    window.addEventListener('load', () => {
      const canvas = document.getElementById('embers-canvas');
      const ctx = canvas.getContext('2d');

      let width = canvas.width = window.innerWidth;
      let height = canvas.height = window.innerHeight;

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      const particles = [];
      const particleCount = 50;

      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          radius: Math.random() * 2 + 0.5,
          color: `rgba(${220 + Math.floor(Math.random() * 35)}, ${160 + Math.floor(Math.random() * 60)}, ${20 + Math.floor(Math.random() * 40)}, ${Math.random() * 0.7 + 0.3})`,
          speedX: (Math.random() - 0.5) * 0.6,
          speedY: -Math.random() * 0.8 - 0.3,
          pulse: Math.random() * Math.PI
        });
      }

      function animateEmbers() {
        ctx.clearRect(0, 0, width, height);

        particles.forEach(p => {
          p.x += p.speedX;
          p.y += p.speedY;
          p.pulse += 0.03;

          if (p.y < 0) {
            p.y = height + 10;
            p.x = Math.random() * width;
          }
          if (p.x < 0 || p.x > width) {
            p.speedX *= -1;
          }

          const opacity = (Math.sin(p.pulse) + 1) / 2 * 0.6 + 0.3;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = opacity;
          ctx.shadowBlur = 8;
          ctx.shadowColor = '#ffd700';
          ctx.fill();
        });

        requestAnimationFrame(animateEmbers);
      }

      animateEmbers();
    });
  </script>
