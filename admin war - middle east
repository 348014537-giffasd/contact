<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>حرب الأدمن - مكافآت الفعالية</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Arabic Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800;900&family=Changa:wght@500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Changa', 'Cairo', sans-serif;
      background-color: #030204;
      color: #f3e5ab;
      overflow-x: hidden;
      user-select: none;
    }

    /* Ambient Gold Embers Canvas Overlay */
    #embers-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 1;
    }

    /* Gothic Castle Background Layer */
    .bg-gothic-castle {
      background: 
        radial-gradient(circle at 50% 12%, rgba(245, 158, 11, 0.22) 0%, transparent 65%),
        radial-gradient(circle at 50% 100%, rgba(3, 2, 4, 0.98) 0%, rgba(3, 2, 4, 0.95) 100%),
        linear-gradient(180deg, rgba(8, 4, 10, 0.92) 0%, rgba(3, 2, 4, 0.98) 100%),
        url('https://images.unsplash.com/photo-1599707367072-cd6ada2bc375?q=80&w=1200&auto=format&fit=crop');
      background-size: cover;
      background-position: center top;
      background-attachment: fixed;
    }

    /* Metallic Gold Text Styling */
    .gold-metallic-text {
      background: linear-gradient(180deg, #ffffff 0%, #fff4b8 20%, #ffd700 50%, #b8860b 80%, #5e4102 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 6px rgba(0,0,0,0.95));
    }

    .silver-metallic-text {
      background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 25%, #cbd5e1 55%, #64748b 85%, #334155 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 5px rgba(0,0,0,0.9));
    }

    .bronze-metallic-text {
      background: linear-gradient(180deg, #ffffff 0%, #ffedd5 25%, #fb923c 55%, #c2410c 85%, #7c2d12 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0px 2px 5px rgba(0,0,0,0.9));
    }

    /* Heraldic Banner Flaps on Left/Right */
    .heraldic-banner-left {
      position: absolute;
      top: 15px;
      left: -2px;
      width: 28px;
      height: 120px;
      background: linear-gradient(180deg, #b91c1c 0%, #7f1d1d 70%, #450a0a 100%);
      border: 1px solid #fef08a;
      border-top: none;
      clip-path: polygon(0 0, 100% 0, 100% 85%, 50% 100%, 0 85%);
      box-shadow: 0 10px 15px rgba(0,0,0,0.9);
      z-index: 25;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 10px;
    }

    .heraldic-banner-right {
      position: absolute;
      top: 15px;
      right: -2px;
      width: 28px;
      height: 120px;
      background: linear-gradient(180deg, #1e3a8a 0%, #1e1b4b 70%, #0f172a 100%);
      border: 1px solid #fef08a;
      border-top: none;
      clip-path: polygon(0 0, 100% 0, 100% 85%, 50% 100%, 0 85%);
      box-shadow: 0 10px 15px rgba(0,0,0,0.9);
      z-index: 25;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 10px;
    }

    /* Medieval Gothic Pillars Frame */
    .stone-pillar {
      background: linear-gradient(90deg, #09060b 0%, #1c1921 40%, #2a2632 50%, #17141d 80%, #070509 100%);
      border-left: 1px solid #4a3b2c;
      border-right: 1px solid #4a3b2c;
      box-shadow: inset 0 0 15px rgba(0,0,0,0.9), 0 0 20px rgba(0,0,0,0.9);
    }

    /* Metallic Bevel Cards */
    .card-top1 {
      position: relative;
      background: linear-gradient(145deg, rgba(48, 28, 8, 0.96) 0%, rgba(18, 9, 14, 0.98) 100%);
      border: 2px solid #ffd700;
      box-shadow: 
        0 0 35px rgba(255, 215, 0, 0.35),
        inset 0 0 20px rgba(255, 193, 7, 0.25),
        0 12px 30px rgba(0, 0, 0, 0.95);
      transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    }

    .card-top2 {
      background: linear-gradient(145deg, rgba(22, 28, 38, 0.96) 0%, rgba(10, 12, 18, 0.98) 100%);
      border: 2px solid #94a3b8;
      box-shadow: 0 0 22px rgba(148, 163, 184, 0.25), inset 0 0 12px rgba(255, 255, 255, 0.1);
    }

    .card-top3 {
      background: linear-gradient(145deg, rgba(35, 20, 12, 0.96) 0%, rgba(15, 8, 8, 0.98) 100%);
      border: 2px solid #ea580c;
      box-shadow: 0 0 22px rgba(234, 88, 12, 0.25), inset 0 0 12px rgba(253, 186, 116, 0.1);
    }

    .card-standard {
      background: linear-gradient(180deg, rgba(22, 16, 22, 0.92) 0%, rgba(10, 8, 12, 0.96) 100%);
      border: 1px solid #785d32;
      box-shadow: 0 6px 15px rgba(0,0,0,0.85);
    }

    /* Filigree Corner Accents */
    .corner-filigree {
      position: absolute;
      width: 12px;
      height: 12px;
      border-color: #ffd700;
      pointer-events: none;
    }
    .corner-tl { top: 3px; right: 3px; border-top: 2px solid; border-right: 2px solid; }
    .corner-tr { top: 3px; left: 3px; border-top: 2px solid; border-left: 2px solid; }
    .corner-bl { bottom: 3px; right: 3px; border-bottom: 2px solid; border-right: 2px solid; }
    .corner-br { bottom: 3px; left: 3px; border-bottom: 2px solid; border-left: 2px solid; }

    /* Shimmer Sweep Effect */
    @keyframes shimmerSweep {
      0% { transform: translateX(-150%) rotate(25deg); }
      100% { transform: translateX(180%) rotate(25deg); }
    }
    .shimmer-sweeper {
      position: relative;
      overflow: hidden;
    }
    .shimmer-sweeper::after {
      content: '';
      position: absolute;
      top: -100%;
      left: -100%;
      width: 300%;
      height: 300%;
      background: linear-gradient(
        60deg,
        transparent 42%,
        rgba(255, 240, 160, 0.22) 50%,
        transparent 58%
      );
      transform: rotate(25deg);
      animation: shimmerSweep 4s infinite linear;
      pointer-events: none;
    }

    /* Torch Flame Animation */
    @keyframes torchFlicker {
      0%, 100% { opacity: 0.9; transform: scale(1) rotate(-1deg); filter: drop-shadow(0 0 12px #f97316); }
      50% { opacity: 1; transform: scale(1.1) rotate(1deg); filter: drop-shadow(0 0 22px #eab308); }
    }
    .torch-flame {
      animation: torchFlicker 1.6s infinite ease-in-out;
    }

    /* Tab Switcher Navigation Styling */
    .tab-btn {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
      position: relative;
    }
    .tab-active {
      background: linear-gradient(180deg, #f59e0b 0%, #b45309 60%, #451a03 100%);
      color: #ffffff;
      box-shadow: 0 -4px 22px rgba(245, 158, 11, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.5);
      border: 1.5px solid #fef08a;
      border-bottom: 3px solid #fef08a;
    }
    .tab-inactive {
      background: rgba(18, 10, 16, 0.9);
      color: #a1a1aa;
      border: 1px solid #451a03;
      border-bottom: 2px solid #271302;
    }

    /* Item Badge Cards */
    .item-card {
      background: linear-gradient(135deg, rgba(38, 22, 10, 0.9) 0%, rgba(14, 7, 9, 0.95) 100%);
      border: 1px solid rgba(245, 158, 11, 0.4);
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .item-card:hover {
      border-color: rgba(253, 224, 71, 0.85);
      transform: translateY(-1px);
    }
  </style>
</head>

<body class="min-h-screen bg-gothic-castle flex justify-center items-start py-3 px-1 sm:px-4 relative">

